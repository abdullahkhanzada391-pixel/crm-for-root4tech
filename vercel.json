{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd root4tech-crm/frontend && npm install --include=dev",
  "buildCommand": "cd root4tech-crm/frontend && npm run build",
  "outputDirectory": "root4tech-crm/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
